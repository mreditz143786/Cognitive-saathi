{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient user profile and cognitive care attributes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "preferredName": { "type": "string" },
        "username": { "type": "string" },
        "age": { "type": "number" },
        "region": { "type": "string" },
        "state": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "phone": { "type": "string" },
        "hasCaregiver": { "type": "boolean" },
        "caregiverName": { "type": "string" },
        "caregiverPhone": { "type": "string" },
        "linkedCaregiverKey": { "type": "string" },
        "patientKey": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "dailyStreak": { "type": "number" },
        "todayCompletedCount": { "type": "number" },
        "lastActiveAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "preferredLanguage"]
    },
    "Caregiver": {
      "title": "Caregiver",
      "description": "Caregiver or family member profile with linked patient IDs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "relation": { "type": "string" },
        "caregiverKey": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "assignedPatientIds": {
          "type": "array"
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName"]
    },
    "CaregiverKey": {
      "title": "CaregiverKey",
      "description": "Invitation or connection key generated by a patient for cross-device linking",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "patientId": { "type": "string" },
        "redeemed": { "type": "boolean" },
        "redeemedByCaregiverId": { "type": "string" },
        "createdAt": { "type": "string" },
        "redeemedAt": { "type": "string" }
      },
      "required": ["patientId", "redeemed"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Cognitive activity or game completed by patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "gameTitle": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "gameId", "completedAt"]
    },
    "RoutineTask": {
      "title": "RoutineTask",
      "description": "Daily living or wellness routine task for patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "timeOfDay": { "type": "string" },
        "completed": { "type": "boolean" },
        "streak": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "ReminderItem": {
      "title": "ReminderItem",
      "description": "Scheduled reminder or medication alert for patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "completedToday": { "type": "boolean" }
      },
      "required": ["id", "title"]
    },
    "MemoryMoment": {
      "title": "MemoryMoment",
      "description": "Reminiscence moment or family photo story for patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "story": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient root documents"
    },
    "/caregivers/{caregiverId}": {
      "schema": "Caregiver",
      "description": "Caregiver root documents"
    },
    "/caregiverKeys/{key}": {
      "schema": "CaregiverKey",
      "description": "Invitation keys for linking caregiver and patient"
    },
    "/patients/{patientId}/sessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Completed cognitive game sessions for patient"
    },
    "/patients/{patientId}/routines/{routineId}": {
      "schema": "RoutineTask",
      "description": "Daily routines for patient"
    },
    "/patients/{patientId}/reminders/{reminderId}": {
      "schema": "ReminderItem",
      "description": "Scheduled reminders for patient"
    },
    "/patients/{patientId}/memories/{memoryId}": {
      "schema": "MemoryMoment",
      "description": "Reminiscence memories for patient"
    }
  }
}
